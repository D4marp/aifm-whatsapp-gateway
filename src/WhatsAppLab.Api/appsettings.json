{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=WhatsAppLabReal;Trusted_Connection=true;Encrypt=true;TrustServerCertificate=true;MultipleActiveResultSets=true"
  },
  "WhatsApp": {
    "Client": "Real",
    "AutoConnect": true,
    "ShowBrowser": false
  },
  "Lab": {
    "AutoMigrate": true,
    "DispatchEverySeconds": 2
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Hangfire": "Warning"
    }
  },
  "AllowedHosts": "*"
}
